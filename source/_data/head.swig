{# SEO + GEO Enhancement — JSON-LD only, canonical/OG handled by NexT theme #}
{# BlogPosting + FAQPage generated by scripts/seo-json-ld.js #}
{% if page.noindex %}
<meta name="robots" content="noindex,nofollow">
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Lanky的技术博客",
  "url": "{{ config.url }}",
  "description": "{{ config.description }}",
  "inLanguage": "zh-CN"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Lanky",
  "url": "{{ config.url }}",
  "jobTitle": "Database & Data Lake Engineer",
  "knowsAbout": ["Apache Calcite", "StarRocks", "ClickHouse", "Apache Iceberg", "OLAP", "Data Lakehouse", "TPC-DS Benchmark", "DuckDB", "Trino", "SQL Parser", "AI Coding"]
}
</script>

{% if page.title %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "{{ config.url }}" },
    { "@type": "ListItem", "position": 2, "name": "{{ page.title }}", "item": "{{ config.url }}/{{ page.path }}" }
  ]
}
</script>
{% endif %}
